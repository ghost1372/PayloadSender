<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="PayloadSender.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dev="using:DevWinUI"
        xmlns:local="using:PayloadSender"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="{x:Bind dev:ProcessInfoHelper.ProductName}" Subtitle="{x:Bind dev:ProcessInfoHelper.VersionWithPrefix}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button Click="Button_Click" Style="{ThemeResource SubtleButtonStyle}">
                    <ImageIcon Width="18" Height="18" Source="ms-appx:///Assets/Fluent/Github.png" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>
        <Grid Grid.Row="1" Margin="10,15,10,10" ColumnSpacing="5" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" Header="IP Address" IsEditable="True" ItemsSource="{x:Bind ViewModel.AddressList, Mode=OneWay}" PlaceholderText="192.168.1.36" SelectedItem="{x:Bind ViewModel.SelectedAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <NumberBox x:Name="NBPort" Grid.Column="1" MinWidth="180" Header="Port" Maximum="999999" PlaceholderText="9021" SpinButtonPlacementMode="Inline" Value="9021" />
            <TextBox x:Name="TxtPayloadFilePath" Grid.Row="2" Header="Payload File Path" IsReadOnly="True" />
            <Button x:Name="BtnOpenFile" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Click="BtnOpenFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ImageIcon Width="18" Height="18" Margin="0,0,0,-5" Source="ms-appx:///Assets/Fluent/FilePicker.png" />
                    <TextBlock Text="Open File" />
                </StackPanel>
            </Button>
            <NavigationViewItemSeparator Grid.Row="3" Grid.ColumnSpan="2" />
            <Button x:Name="BtnSendPayload" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Click="BtnSendPayload_Click" Content="Send Payload" IsEnabled="False" Style="{ThemeResource AccentButtonStyle}" />
            <dev:StorageBar x:Name="PrgStatus" Grid.Row="5" Grid.ColumnSpan="2" Maximum="100" PercentCaution="10001" PercentCritical="10001" Visibility="Collapsed" Value="0" />
            <InfoBar x:Name="IFStatus" Title="Please open your payload file and click Send Payload." Grid.Row="6" Grid.ColumnSpan="2" IsClosable="False" IsOpen="True" />
        </Grid>
    </Grid>
</Window>

